# Variáveis de ambiente necessárias para instalação self-hosted do VaultFlow
# NUNCA versione chaves reais nem utilize valores de exemplo em produção.

# 1. Banco de Metadados PostgreSQL (Prisma)
DATABASE_URL=""
DIRECT_URL=""

# 2. Painel Administrativo (NextAuth)
# Gere um segredo único de pelo menos 32 bytes: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://127.0.0.1:3000"

# 3. Comunicação Interna Servidor-Servidor (Next.js -> API Express)
# Deve ser um segredo distinto de NEXTAUTH_SECRET (mínimo 32 caracteres): openssl rand -hex 32
INTERNAL_API_TOKEN=""
API_URL="http://localhost:4000"
PORT="4000"

# 4. Cifragem Local das Credenciais Persistidas (AES-256-GCM)
# Caminho para arquivo local protegido (permissão 0600) contendo 32 bytes em hex (openssl rand -hex 32)
VAULTFLOW_MASTER_KEY_FILE=""

# 5. Conta Administrativa Inicial (usada apenas no seed / reset local explícito)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# 6. Limites Operacionais e Volumes Locais Permitidos (Opcional)
CRON_TIMEZONE="America/Sao_Paulo"
MAX_CONCURRENT_BACKUPS="1"
BACKUP_TIMEOUT_MS="1800000"
ALLOWED_LOCAL_BACKUP_ROOTS=""
