    "seed": "tsx seed.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "prisma": "^5.14.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  }
}
